#------------------------------------------------------------------------------
# Windows 64-bit C compiler settings - MSVC ABI implicit
#------------------------------------------------------------------------------

SUFFIXES   += .c

# Use AMD ROCm's Clang for consistency
ifneq (,$(HIP_PATH_SHORT))
    cc      = $(HIP_PATH_SHORT)/bin/clang -std=c11
else
    cc      = clang -std=c11
endif

cARCH       = -m64
cDBUG       =
cOPT        = -O2

cWARN       = -Wall -Wextra -Wno-unused-parameter

ifneq (,$(strip $(WM_COMPILE_OPTION)))
    sinclude $(DEFAULT_RULES)/c$(WM_COMPILE_OPTION)
endif

cFLAGS      = $(cARCH) $(GFLAGS) $(cWARN) $(cOPT) $(cDBUG) \
    $(FOAM_EXTRA_CFLAGS) $(LIB_HEADER_DIRS)

ctoo        = $(WM_SCHEDULER) $(cc) $(cFLAGS) -c $< -o $@

LINK_LIBS   = $(cDBUG)
LINKEXE     = $(cc) $(cFLAGS)

#------------------------------------------------------------------------------
