#------------------------------------------------------------------------------
# Linux 64-bit SYCL (AdaptiveCpp) C++ compiler settings
#------------------------------------------------------------------------------

include $(GENERAL_RULES)/Sycl/c++

c++ARCH    := -m64 -pthread

ifneq (,$(strip $(WM_COMPILE_OPTION)))
    sinclude $(DEFAULT_RULES)/c++$(WM_COMPILE_OPTION)
endif

c++FLAGS    = \
    $(c++ARCH) $(GFLAGS) $(c++WARN) $(c++OPT) $(c++DBUG) $(ptFLAGS) \
    $(ACPP_FLAGS) $(FOAM_EXTRA_CXXFLAGS) $(LIB_HEADER_DIRS) -fPIC

Ctoo        = $(WM_SCHEDULER) $(CC) $(c++FLAGS) -c $< -o $@
cctoo       = $(Ctoo)
cpptoo      = $(Ctoo)
cxxtoo      = $(Ctoo)

# Clang linker rules: handles the default GNU ld (--add-needed for
# transitive libPstream symbols) as well as +gold/+mold/+lld selection
# via WM_COMPILE_CONTROL (with the dummy Pstream stub those need)
include $(GENERAL_RULES)/Clang/link-c++

