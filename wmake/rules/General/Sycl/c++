#------------------------------------------------------------------------------
# AdaptiveCpp (acpp) SYCL compiler
#------------------------------------------------------------------------------
SUFFIXES   += .C .cc .cpp .cxx

CC         := acpp -std=c++17

c++ARCH    :=
c++DBUG    :=
c++OPT     := -O2
ptFLAGS    := -DNoRepository -Dhave_sycl

c++WARN     = \
    -Wall -Wextra \
    -Wno-unused-parameter -Wno-old-style-cast

# Less restrictive warnings (eg, for flex++, CGAL, etc.)
c++LESSWARN = \
    -Wno-old-style-cast -Wno-unused-local-typedefs \
    -Wno-deprecated-declarations \
    -fpermissive

# AdaptiveCpp target: generic (JIT compiled at run time) unless ACPP_TARGETS
# is set. Only the generic target is supported.
ifeq (,$(strip $(ACPP_TARGETS)))
    override ACPP_TARGETS := generic
endif

# AdaptiveCpp specific flags
ACPP_FLAGS := --acpp-targets=$(ACPP_TARGETS)

# Tuning
sinclude $(GENERAL_RULES)/common/c++$(WM_COMPILE_OPTION)

#------------------------------------------------------------------------------
