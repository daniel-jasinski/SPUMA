/* Windows: per-library macro that makes FOAM_TURB_EXPORT_DATA-marked
 * statics (e.g. turbulenceModel::propertiesName) dllexport in this
 * library's TUs while leaving libOpenFOAM-owned data dllimport. */
ifneq (,$(findstring windows,$(WM_OSTYPE)))
    EXE_INC += -DFOAM_TURB_BUILDING_LIB
endif

EXE_INC += \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools
