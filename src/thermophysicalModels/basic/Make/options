/* Windows: per-library macro that makes FOAM_THERMO_EXPORT_DATA-marked
 * statics (e.g. basicThermo::dictName) dllexport in this library's TUs
 * while leaving libOpenFOAM-owned data dllimport. */
ifneq (,$(findstring windows,$(WM_OSTYPE)))
    EXE_INC += -DFOAM_THERMO_BUILDING_LIB
endif

EXE_INC += \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/transportModels/compressible/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/specie/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/thermophysicalProperties/lnInclude \

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -lcompressibleTransportModels \
    -lspecie \
    -lthermophysicalProperties
