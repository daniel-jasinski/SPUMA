EXE_INC = \
    -I$(OBJECTS_DIR)

/* Windows: define FOAM_BUILDING_LIB so FOAM_EXPORT_DATA becomes dllexport */
ifneq (,$(findstring windows,$(WM_OSTYPE)))
    EXE_INC += -DFOAM_BUILDING_LIB
    LIB_LIBS = \
        $(FOAM_LIBBIN)/libOSspecific.lib \
        -Wl,/DEFAULTLIB:advapi32
else
LIB_LIBS = \
    $(FOAM_LIBBIN)/libOSspecific.o
endif

/* libz: disabled on Windows MSVC (no MSVC-compatible zlib available yet) */
ifeq (,$(findstring windows,$(WM_OSTYPE)))
ifeq (,$(findstring ~libz,$(WM_COMPILE_CONTROL)))
    EXE_INC  += -DHAVE_LIBZ
    LIB_LIBS += -lz
endif
endif

/* extrae profiling hooks [https://tools.bsc.es/extrae] */
ifeq (,$(findstring windows,$(WM_OSTYPE)))
ifeq (,$(findstring ~extrae,$(WM_COMPILE_CONTROL)))
    EXE_INC  += -DHAVE_EXTRAE
endif
endif

/* Never self-link (WM_PROJECT == OpenFOAM), but do link to Pstream */

PROJECT_LIBS =

ifeq (libo,$(FOAM_LINK_DUMMY_PSTREAM))
ifneq (,$(findstring windows,$(WM_OSTYPE)))
    LIB_LIBS += $(FOAM_LIBBIN)/dummy/libPstream_static.lib
else
    LIB_LIBS += $(FOAM_LIBBIN)/dummy/libPstream.o
endif
else
ifneq (,$(findstring windows,$(WM_OSTYPE)))
    # Use the concrete import library so DEF generation retains the Pstream
    # forwarding exports expected by existing Windows OpenFOAM DLLs.
    LIB_LIBS += $(FOAM_LIBBIN)/dummy/libPstream.lib
else
    LIB_LIBS += -L$(FOAM_LIBBIN)/dummy -lPstream
endif
endif

/* umpire memory pool source files */
include $(WM_PROJECT_DIR)/src/OpenFOAM/Make/umpireFiles

ifneq (,$(findstring true,$(have_umpire)))
    LIB_LIBS += -L$(UMPIRE_HOME)/lib -L$(UMPIRE_HOME)/lib64 -lumpire
    EXE_INC += -Dhave_umpire -I$(UMPIRE_HOME)/include
endif

/* platform specific source files */
include $(WM_PROJECT_DIR)/src/OpenFOAM/Make/deviceFiles

ifneq (,$(findstring true,$(have_cuda)))
    LIB_LIBS += -lcudart
    EXE_INC += -Dhave_cuda
endif

ifneq (,$(findstring true,$(have_sycl)))
    EXE_INC += -Dhave_sycl
endif

/* SYCL device code: include .cpp implementation files for inline device code.
   Detect SYCL from compiler name since have_sycl
   may not be passed through to make on Windows. */
ifneq (,$(findstring Sycl,$(WM_COMPILER)))
    EXE_INC += -I$(LIB_SRC)/OpenFOAM/device/executor
    EXE_INC += -I$(LIB_SRC)/OpenFOAM/device/memoryExecutor
endif
