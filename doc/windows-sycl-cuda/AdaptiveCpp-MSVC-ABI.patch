 namespace hipsycl::algorithms::reduction {
 
+// ============================================================================
+// Named functors for MSVC ABI compatibility
+// MSVC mangles lambdas with TU-specific identifiers, causing ODR violations
+// when templates are instantiated across multiple translation units.
+// Named functors have stable, predictable mangling across all TUs.
+// ============================================================================
+
+// Helper functions to invoke kernel with tupled args + extra args (avoids lambda)
+// This allows combining parameter packs without using lambdas that MSVC would mangle
+namespace invoke_helpers {
+
+// Invoke kernel with tuple args expanded + extra reducer args
+template<class Kernel, class Tuple, std::size_t... Is, class... Reducers>
+void invoke_kernel_with_tupled_args_impl(
+    const Kernel& k, const Tuple& t, std::index_sequence<Is...>, Reducers... reducers) {
+  k(std::get<Is>(t)..., reducers...);
+}
+
+template<class Kernel, class... TupleArgs, class... Reducers>
+void invoke_kernel_with_tupled_args(
+    const Kernel& k, const std::tuple<TupleArgs...>& t, Reducers... reducers) {
+  invoke_kernel_with_tupled_args_impl(k, t, std::make_index_sequence<sizeof...(TupleArgs)>{}, reducers...);
+}
 
+// Functor for std::apply that invokes kernel with pre-captured direct args
+template<class Kernel, class DirectArgsTuple>
+struct kernel_reducer_combiner {
+  const Kernel& k;
+  DirectArgsTuple direct_args;
+
+  kernel_reducer_combiner(const Kernel& kernel, DirectArgsTuple args)
+    : k(kernel), direct_args(args) {}
+
+  template<class... Reducers>
+  void operator()(Reducers... reducers) const {
+    invoke_kernel_with_tupled_args(k, direct_args, reducers...);
+  }
+};
+
+// Invoke group_reducer.finalize with fold expression for each reducer
+template<class GroupHorizontalReducer, class WiIndex, class Tuple, std::size_t... Is, class... Descriptors>
+void invoke_finalize_with_reducers_impl(
+    const GroupHorizontalReducer& group_reducer, WiIndex wi_index,
+    const Tuple& reducers_tuple, std::index_sequence<Is...>,
+    const Descriptors&... descs) {
+  (group_reducer.finalize(wi_index, descs, std::get<Is>(reducers_tuple)), ...);
+}
+
+template<class GroupHorizontalReducer, class WiIndex, class... WiReducers, class... Descriptors>
+void invoke_finalize_with_reducers(
+    const GroupHorizontalReducer& group_reducer, WiIndex wi_index,
+    const std::tuple<WiReducers...>& reducers_tuple,
+    const Descriptors&... descs) {
+  invoke_finalize_with_reducers_impl(
+      group_reducer, wi_index, reducers_tuple,
+      std::make_index_sequence<sizeof...(WiReducers)>{}, descs...);
+}
 
+// Functor for std::apply that invokes finalize with pre-captured descriptors
+template<class GroupHorizontalReducer, class WiIndex, class DescriptorsTuple>
+struct finalize_reducer_combiner {
+  const GroupHorizontalReducer& group_reducer;
+  WiIndex wi_index;
+  DescriptorsTuple descs_tuple;
 
+  finalize_reducer_combiner(const GroupHorizontalReducer& gr, WiIndex idx, DescriptorsTuple descs)
+    : group_reducer(gr), wi_index(idx), descs_tuple(descs) {}
+
+  template<class... Reducers>
+  void operator()(Reducers... reducers) const {
+    // Expand descriptors tuple and call finalize for each reducer
+    invoke_finalize_expanded(std::make_index_sequence<std::tuple_size_v<DescriptorsTuple>>{}, reducers...);
+  }
+
+private:
+  template<std::size_t... Is, class... Reducers>
+  void invoke_finalize_expanded(std::index_sequence<Is...>, Reducers... reducers) const {
+    (group_reducer.finalize(wi_index, std::get<Is>(descs_tuple), reducers), ...);
+  }
+};
+
