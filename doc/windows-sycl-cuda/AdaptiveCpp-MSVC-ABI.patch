diff --git a/include/hipSYCL/common/init_priority.hpp b/include/hipSYCL/common/init_priority.hpp
new file mode 100644
--- /dev/null
+++ b/include/hipSYCL/common/init_priority.hpp
@@ -0,0 +1,39 @@
+/*
+ * This file is part of AdaptiveCpp, an implementation of SYCL and C++ standard
+ * parallelism for CPUs and GPUs.
+ *
+ * Copyright The AdaptiveCpp Contributors
+ *
+ * AdaptiveCpp is released under the BSD 2-Clause "Simplified" License.
+ * See file LICENSE in the project root for full license details.
+ */
+// SPDX-License-Identifier: BSD-2-Clause
+#ifndef ACPP_COMMON_INIT_PRIORITY_HPP
+#define ACPP_COMMON_INIT_PRIORITY_HPP
+
+// Windows DLL Static Initialization Order Fix
+//
+// The LLVM linker on Windows doesn't preserve object file order for static
+// constructors like GCC's GNU ld does on Linux. This causes SIOF (Static
+// Initialization Order Fiasco) when user DLLs try to access runtime singletons
+// before they're initialized.
+//
+// Priority levels (lower = earlier initialization):
+//   101      - ACPP_INIT_PRIORITY_RUNTIME_CORE: Core runtime singletons
+//   102-200  - Reserved for runtime internals
+//   65534    - ACPP_INIT_PRIORITY_USER: User-side statics (header-injected)
+//   65535    - Default priority (unspecified)
+//
+// Header-injected static objects (persistent_runtime, hcf_registration,
+// reflection_init) use ACPP_INIT_PRIORITY_USER to ensure they run late,
+// after all runtime singletons are guaranteed to be initialized.
+
+#if defined(_WIN32) && (defined(__GNUC__) || defined(__clang__))
+  #define ACPP_INIT_PRIORITY_RUNTIME_CORE __attribute__((init_priority(101)))
+  #define ACPP_INIT_PRIORITY_USER __attribute__((init_priority(65534)))
+#else
+  #define ACPP_INIT_PRIORITY_RUNTIME_CORE
+  #define ACPP_INIT_PRIORITY_USER
+#endif
+
+#endif // ACPP_COMMON_INIT_PRIORITY_HPP
diff --git a/src/compiler/acpp-clang.def b/src/compiler/acpp-clang.def
new file mode 100644
--- /dev/null
+++ b/src/compiler/acpp-clang.def
@@ -0,0 +1,20 @@
+; Module definition file for acpp-clang.dll
+; Minimal exports for clang plugin registration
+;
+; This file lists only the exact symbols required for clang to load and
+; register the AdaptiveCpp compiler plugin. Using --exclude-all-symbols
+; plus this .def file overcomes the Windows PE export limit (65535 symbols).
+
+LIBRARY acpp-clang
+
+EXPORTS
+    ; Frontend plugin registration - clang looks for these
+    _ZN4llvm8RegistryIN5clang15PluginASTActionEE3AddIN7hipsycl8compiler17FrontendASTActionEE6CtorFnEv
+    _ZN4llvm8RegistryIN5clang15PluginASTActionEE4HeadE DATA
+    _ZN4llvm8RegistryIN5clang15PluginASTActionEE4TailE DATA
+    _ZN4llvm8RegistryIN5clang15PluginASTActionEE5beginEv
+    _ZN4llvm8RegistryIN5clang15PluginASTActionEE8add_nodeEPNS3_4nodeE
+
+    ; Pass plugin registration - required for -fpass-plugin
+    llvmGetPassPluginInfo
+    _Z24getAdaptiveCppPluginInfov
