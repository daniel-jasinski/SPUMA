+#ifdef ACPP_MSVC_ABI_TARGET
+// Simple FNV-1a hash for stable kernel naming on MSVC ABI
+// Using 64-bit hash for good collision resistance
+inline uint64_t fnv1aHash(const std::string& str) {
+  const uint64_t FNV_PRIME = 0x100000001b3ULL;
+  const uint64_t FNV_OFFSET = 0xcbf29ce484222325ULL;
+
+  uint64_t hash = FNV_OFFSET;
+  for (char c : str) {
+    hash ^= static_cast<uint64_t>(static_cast<unsigned char>(c));
+    hash *= FNV_PRIME;
+  }
+  return hash;
+}
+
+// Canonicalize a kernel name by removing TU-specific MSVC mangling components
+// This extracts a stable representation from the mangled name
+inline std::string canonicalizeMSVCKernelName(const std::string& MangledName) {
+  std::string Result;
+  Result.reserve(MangledName.size());
+
+  size_t i = 0;
+  while (i < MangledName.size()) {
+    // Skip MSVC anonymous namespace markers: ?A0x followed by 8 hex chars
+    // These are TU-specific hashes
+    if (i + 11 < MangledName.size() &&
+        MangledName[i] == '?' && MangledName[i+1] == 'A' &&
+        MangledName[i+2] == '0' && MangledName[i+3] == 'x') {
+      // Skip ?A0x and the 8 hex digits
+      i += 4;
+      while (i < MangledName.size() && std::isxdigit(MangledName[i])) {
+        ++i;
+      }
+      // Skip trailing @ if present
+      if (i < MangledName.size() && MangledName[i] == '@') {
+        ++i;
+      }
+      continue;
+    }
+
+    // Normalize lambda numbering: <lambda_N> -> <lambda>
+    // MSVC numbers lambdas per TU, so we strip the number
+    if (i + 8 < MangledName.size() &&
+        MangledName.substr(i, 8) == "<lambda_") {
+      Result += "<lambda>";
+      i += 8;
+      // Skip digits
+      while (i < MangledName.size() && std::isdigit(MangledName[i])) {
+        ++i;
+      }
+      // Skip closing >
+      if (i < MangledName.size() && MangledName[i] == '>') {
+        ++i;
+      }
+      continue;
+    }
+
+    // Keep other characters
+    Result += MangledName[i];
+    ++i;
+  }
+
+  return Result;
+}
+
+// Generate a stable kernel name for MSVC ABI targets
+// Uses hash of canonicalized name to ensure consistency across TUs
+inline std::string generateStableMSVCKernelName(const std::string& OriginalName,
+                                                 const std::string& FunctionSignature) {
+  // Canonicalize the name to remove TU-specific components
+  std::string Canonical = canonicalizeMSVCKernelName(OriginalName);
+
+  // Combine with function signature for additional uniqueness
+  std::string Combined = Canonical + "|" + FunctionSignature;
+
+  // Compute hash
+  uint64_t Hash = fnv1aHash(Combined);
+
+  // Format as hex string: __acpp_kernel_XXXXXXXXXXXXXXXX
+  char HashStr[32];
+  snprintf(HashStr, sizeof(HashStr), "__acpp_kernel_%016llx",
+           static_cast<unsigned long long>(Hash));
+
+  return std::string(HashStr);
+}
+#endif // ACPP_MSVC_ABI_TARGET
+
 } // namespace hipsycl::compiler
 #endif
