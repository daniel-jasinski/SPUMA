+// Helper to invoke kernel with variadic args
+template<class Kernel, class... WiReducers>
+struct kernel_invoker_with_reducers {
+  const Kernel& k;
+  std::tuple<WiReducers...> wi_reducers;
+
+  kernel_invoker_with_reducers(const Kernel& kernel, WiReducers... reducers)
+    : k(kernel), wi_reducers(reducers...) {}
+
+  template<class... DirectArgs>
+  void operator()(DirectArgs... args) const {
+    // Use named functor instead of lambda for MSVC ABI compatibility
+    invoke_helpers::kernel_reducer_combiner<Kernel, std::tuple<DirectArgs...>> combiner{
+        k, std::make_tuple(args...)};
+    std::apply(combiner, wi_reducers);
+  }
+};
+
+// Helper to finalize reductions
+template<class GroupHorizontalReducer, class WiIndex, class... WiReducers>
+struct reduction_finalizer {
+  const GroupHorizontalReducer& group_reducer;
+  WiIndex wi_index;
+  std::tuple<WiReducers...> wi_reducers;
+
+  reduction_finalizer(const GroupHorizontalReducer& gr, WiIndex idx, WiReducers... reducers)
+    : group_reducer(gr), wi_index(idx), wi_reducers(reducers...) {}
+
+  template<class... Descriptors>
+  void operator()(const Descriptors&... descs) const {
+    // Use direct invocation with index_sequence instead of lambda for MSVC ABI compatibility
+    invoke_helpers::invoke_finalize_with_reducers(group_reducer, wi_index, wi_reducers, descs...);
+  }
+};
+
+// Helper to generate wi_reducers and call implementation
+template<class Wrapper, class DirectArgsTuple>
+struct wi_reducer_generator {
+  const Wrapper* wrapper;
+  DirectArgsTuple direct_args;
+
+  wi_reducer_generator(const Wrapper* w, DirectArgsTuple args)
+    : wrapper(w), direct_args(args) {}
+
+  template<class... Descriptors>
+  void operator()(const Descriptors&... descs) const {
+    wrapper->call_impl_internal(direct_args, wrapper->group_reducer.generate_wi_reducer(descs)...);
+  }
+};
+
+// Named functor for inner kernel wrapper - calls user kernel and finalizes reductions
+template<class Kernel, class GroupHorizontalReducer, class... ConfiguredReductionDescriptors>
+struct reduction_kernel_inner_wrapper {
+  Kernel k;
+  GroupHorizontalReducer group_reducer;
+  std::tuple<ConfiguredReductionDescriptors...> descriptors;
+
+  reduction_kernel_inner_wrapper(
+      const Kernel& kernel,
+      const GroupHorizontalReducer& reducer,
+      const ConfiguredReductionDescriptors&... descs)
+    : k(kernel), group_reducer(reducer), descriptors(descs...) {}
+
+  template<class DirectArgsTuple, class... WiReducers>
+  void call_impl_internal(DirectArgsTuple direct_args, WiReducers... wi_reducers) const {
+    // Call the kernel with direct args + reducers
+    std::apply(kernel_invoker_with_reducers<Kernel, WiReducers...>{k, wi_reducers...}, direct_args);
+
+    // Finalize reductions
+    auto wi_index = std::get<0>(direct_args);
+    reduction_finalizer<GroupHorizontalReducer, decltype(wi_index), WiReducers...>
+        finalizer{group_reducer, wi_index, wi_reducers...};
+    std::apply(finalizer, descriptors);
+  }
+
+  template<class... DirectKernelArgs>
+  void operator()(DirectKernelArgs... direct_kernel_args) const {
+    auto direct_args_tuple = std::make_tuple(direct_kernel_args...);
+    wi_reducer_generator<reduction_kernel_inner_wrapper, decltype(direct_args_tuple)>
+        generator{this, direct_args_tuple};
+    std::apply(generator, descriptors);
+  }
+};
+
+// Helper functor to execute dedicated reductions from tuple
+template<class GroupHorizontalReducer, class WiIndex>
+struct dedicated_reduction_executor {
+  const GroupHorizontalReducer& group_reducer;
+  WiIndex first_arg;
+
+  dedicated_reduction_executor(const GroupHorizontalReducer& gr, WiIndex fa)
+    : group_reducer(gr), first_arg(fa) {}
+
+  template<class ConfiguredDescriptor>
+  static void execute_single(
+      WiIndex wi_index, const GroupHorizontalReducer &reducer,
+      const ConfiguredDescriptor &descriptor) {
+
+    auto wi_reducer = reducer.generate_wi_reducer(descriptor);
+    std::size_t my_id = wg_model::get_global_linear_id(wi_index);
+
+    if(my_id < descriptor.get_problem_size()) {
+      if (descriptor.has_known_identity() ||
+          descriptor.get_input_initialization_state()[my_id]) {
+        wi_reducer.combine(descriptor.get_stage_input()[my_id]);
+      }
+    }
+    reducer.finalize(wi_index, descriptor, wi_reducer);
+  }
+
+  template<class... Descriptors>
+  void operator()(const Descriptors&... input_refs) const {
+    (execute_single(first_arg, group_reducer, input_refs), ...);
+  }
+};
+
+// Named functor for dedicated reduction kernel
+template<class GroupHorizontalReducer, class... ConfiguredReductionDescriptors>
+struct dedicated_reduction_kernel_functor {
+  GroupHorizontalReducer group_reducer;
+  std::tuple<ConfiguredReductionDescriptors...> inputs;
+
+  dedicated_reduction_kernel_functor(
+      const GroupHorizontalReducer& gr,
+      const ConfiguredReductionDescriptors&... ins)
+    : group_reducer(gr), inputs(ins...) {}
+
+  template<class FirstArg, class... DirectKernelArgs>
+  void operator()(FirstArg first_arg, DirectKernelArgs&&...) const {
+    dedicated_reduction_executor<GroupHorizontalReducer, FirstArg> executor{group_reducer, first_arg};
+    std::apply(executor, inputs);
+  }
+};
