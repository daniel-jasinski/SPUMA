# File
#     etc/config.sh/amgx
#
# Description
#     Setup for NVIDIA AmgX include/libraries (used by the
#     modules/foamExternalSolvers AmgX4Foam module).
#
#     A pre-set AMGX_ARCH_PATH (pointing at an AmgX install prefix with
#     include/ and lib/) always wins; otherwise a ThirdParty-style default
#     location is assumed.
#
#     On Windows, wmake passes variables to make unquoted: the AmgX prefix
#     and a CUDA_CLANG path containing spaces are shortened to 8.3 form
#     (forward slashes). CUDA_PATH_SHORT is derived from CUDA_PATH by wmake
#     itself.
#
#     Runtime: the AmgX shared library must be found by the loader.
#     Sourced from etc/bashrc (or via foamEtcFile -config amgx -- -force)
#     the library directory is added to PATH (Windows) or LD_LIBRARY_PATH.
#------------------------------------------------------------------------------

amgx_version=amgx-2.5.0

if [ -z "$AMGX_ARCH_PATH" ]
then
    export AMGX_ARCH_PATH="$WM_THIRD_PARTY_DIR/platforms/$WM_ARCH$WM_COMPILER/$amgx_version"
fi

# END OF (NORMAL) USER EDITABLE PART
#------------------------------------------------------------------------------

case "$WM_OSTYPE" in
(*[Ww]indows*)
    # Spaces do not survive wmake's unquoted variable passing.
    # Shorten to 8.3 form (forward slashes) - only accept the result when
    # cygpath succeeded (the path exists) and the spaces are really gone
    # (8.3 names may be disabled on the volume).
    #   $1 = variable name (value is a path)
    _amgxShorten()
    {
        eval "amgx_path=\"\$$1\""
        case "$amgx_path" in
        (*' '*)
            if command -v cygpath >/dev/null
            then
                amgx_short="$(cygpath -m -s "$amgx_path" 2>/dev/null)"
            else
                amgx_short=""
            fi
            case "$amgx_short" in
            ('' | *' '*)
                echo "amgx: cannot shorten $1='$amgx_path'" \
                    "(spaces break wmake on Windows)" 1>&2
                ;;
            (*)
                eval "$1=\"\$amgx_short\"; export $1"
                ;;
            esac
            ;;
        esac
        unset amgx_path amgx_short
    }

    _amgxShorten AMGX_ARCH_PATH

    # clang++ for the .cu sources (module option -cuda), used unquoted
    # by the module's wmake/clang-cuda rules
    if [ -n "$CUDA_CLANG" ]
    then
        _amgxShorten CUDA_CLANG
    fi

    unset -f _amgxShorten
    ;;
esac

export AMGX_INC="$AMGX_ARCH_PATH/include"
export AMGX_LIB="$AMGX_ARCH_PATH/lib"

if [ -n "$FOAM_VERBOSE" ] && [ -n "$PS1" ]
then
    echo "Using amgx ($amgx_version)  ->  $AMGX_ARCH_PATH" 1>&2
fi

# Runtime library path.
# On Windows the directory goes on PATH (DLL lookup) in POSIX form:
# _foamAddLib accepts only /-rooted paths, and a C:/ entry would be split
# at its colon by the shell.
amgx_libdir="$AMGX_LIB"
case "$WM_OSTYPE" in
(*[Ww]indows*)
    if command -v cygpath >/dev/null
    then
        amgx_libdir="$(cygpath -u "$AMGX_LIB" 2>/dev/null || echo "$AMGX_LIB")"
    fi
    ;;
esac

if command -v _foamAddLib >/dev/null
then
    # Normal sourcing (from etc/bashrc)
    [ -d "$amgx_libdir" ] && _foamAddLib "$amgx_libdir"
elif [ "$1" = "-force" ]
then
    # Forced command-line sourcing
    case "$WM_OSTYPE" in
    (*[Ww]indows*)
        # DLLs are located via PATH
        [ -d "$amgx_libdir" ] && export PATH="$amgx_libdir${PATH:+:}$PATH"
        ;;
    (*)
        if output="$($WM_PROJECT_DIR/bin/tools/lib-dir -sh $AMGX_ARCH_PATH 2>/dev/null)"
        then
            eval "$output"
        fi
        unset output
        ;;
    esac
fi

unset amgx_version amgx_libdir

#------------------------------------------------------------------------------
