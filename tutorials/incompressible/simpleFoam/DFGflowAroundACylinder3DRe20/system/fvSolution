FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        twoStageGaussSeidel;
        tolerance       1e-07;
        relTol          0.01;
        maxIter         100;
    }

    pFinal
    {
        $p;
        relTol          0;
    }

    U
    {
        solver          smoothSolver;
        smoother        twoStageGaussSeidel;
        tolerance       0;
        relTol          0;
        maxIter         5;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;

    residualControl
    {
        p               1e-07;
        U               1e-07;
    }
}

// For coupledSolver
relaxationFactors
{
    fields
    {
        p            0.3;
    }
    equations
    {
        U            0.7;
    }
}

PISO
{
    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}

