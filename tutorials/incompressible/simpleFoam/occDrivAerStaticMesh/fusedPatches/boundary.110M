FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type      patch;
        nFaces    495;
        startFace 364685563;
    }
    outlet
    {
        type      patch;
        nFaces    693;
        startFace 364686058;
    }
    freestream
    {
        type      symmetry;
        inGroups  1(symmetry);
        nFaces    6438;
        startFace 364686751;
    }
    ground
    {
        type      wall;
        inGroups  1(wall);
        nFaces    6936;
        startFace 364693189;
    }
    forcesWallPatch
    {
        type      wall;
        inGroups  1(wall);
        nFaces    8113337;
        startFace 364700125;

    }
    noSlipGroundPatch
    {
        type      wall;
        inGroups  1(wall);
        nFaces    1284844;
        startFace 372813462;

    }
)

