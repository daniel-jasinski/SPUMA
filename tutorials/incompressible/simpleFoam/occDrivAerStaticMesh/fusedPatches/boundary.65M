FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type      patch;
        nFaces    390;
        startFace 197353234;
    }
    outlet
    {
        type      patch;
        nFaces    546;
        startFace 197353624;
    }
    freestream
    {
        type      symmetry;
        inGroups  1(symmetry);
        nFaces    3864;
        startFace 197354170;
    }
    ground
    {
        type      wall;
        inGroups  1(wall);
        nFaces    3564;
        startFace 197358034;
    }
    forcesWallPatch
    {
        type      wall;
        inGroups  1(wall);
        nFaces    5229313;
        startFace 197361598;
    }
    noSlipGroundPatch
    {
        type      wall;
        inGroups  1(wall);
        nFaces    680957;
        startFace 202590911;
    }
)

